{
  "name": "team-accessibility-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -b && vite build",
    "preanalyze:bundle": "node scripts/clean-dist.mjs",
    "analyze:bundle": "tsc -b && vite build --mode analyze",
    "test:bundle": "npm run analyze:bundle && node scripts/verify-bundle-boundaries.mjs",
    "preview": "vite preview",
    "pretest": "npm run test:bundle && npm run test:unit",
    "test": "node scripts/run-frontend-tests.mjs --suite ci",
    "test:unit": "vitest run",
    "test:ci": "npm test",
    "test:browser": "node scripts/run-frontend-tests.mjs --suite browser",
    "test:recovery": "node scripts/run-frontend-tests.mjs --suite recovery",
    "test:visual": "node scripts/run-frontend-tests.mjs --suite visual",
    "test:replay": "node scripts/run-frontend-tests.mjs --suite replay",
    "test:backend": "node scripts/run-frontend-tests.mjs --suite backend",
    "verify:a11y-p0": "node scripts/run-frontend-tests.mjs --suite ci --test verify-accessibility-p0.mjs",
    "verify:sidebar-route-selection": "node scripts/run-frontend-tests.mjs --suite ci --test verify-sidebar-route-selection.mjs",
    "verify:polling-cancel": "node scripts/run-frontend-tests.mjs --suite ci --test verify-analysis-polling-cancel.mjs",
    "verify:mutation-refresh": "node scripts/run-frontend-tests.mjs --suite ci --test verify-dashboard-mutation-refresh.mjs",
    "verify:organization-refresh-retry": "node scripts/run-frontend-tests.mjs --suite ci --test verify-organization-create-refresh-retry.mjs",
    "verify:organization-post-timeout": "node scripts/run-frontend-tests.mjs --suite ci --test verify-organization-create-post-timeout.mjs",
    "verify:organization-reload-recovery": "node scripts/run-frontend-tests.mjs --suite ci --test verify-organization-create-reload-recovery.mjs",
    "verify:site-create-retry": "node scripts/run-frontend-tests.mjs --suite ci --test verify-site-create-request-retry.mjs",
    "verify:mutation-submit-guards": "node scripts/run-frontend-tests.mjs --suite ci --test verify-mutation-submit-guards.mjs",
    "verify:quick-recovery": "node scripts/run-frontend-tests.mjs --suite recovery --test verify-quick-rescan-recovery-guards.mjs",
    "verify:route-resilience": "node scripts/run-frontend-tests.mjs --suite ci --test verify-route-resilience-accessibility.mjs",
    "verify:sidebar-selection": "node scripts/run-frontend-tests.mjs --suite ci --test verify-sidebar-selection.mjs",
    "verify:page-evidence": "node scripts/run-frontend-tests.mjs --suite browser --test verify-page-evidence.mjs",
    "verify:api-response-validation": "node scripts/run-frontend-tests.mjs --suite ci --test verify-api-response-validation.mjs",
    "verify:bundle-boundaries": "npm run test:bundle",
    "verify:live-report-markers": "node scripts/run-frontend-tests.mjs --suite replay --test verify-live-report-markers.mjs",
    "verify:landing-design": "node scripts/run-frontend-tests.mjs --suite visual --test verify-landing-design.mjs",
    "record:landing": "node scripts/record-landing-demo.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  }
}
