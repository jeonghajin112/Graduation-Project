# Copy to .env for local development. See README.md "API 연결".
#
# API base. Leave empty to call same-origin /api (through VITE_DEV_PROXY_TARGET).
VITE_API_BASE_URL=http://localhost:9090/api
# Live report viewer origin. http is accepted only for localhost.
VITE_LIVE_REPORT_VIEWER_BASE_URL=http://localhost:9090
# Dev/preview server proxy target for /api (read by vite.config.ts; not used by app code).
VITE_DEV_PROXY_TARGET=
# Extra hostnames allowed by `vite preview`, comma separated (read by vite.config.ts).
VITE_ALLOWED_HOSTS=
